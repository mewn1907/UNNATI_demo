APP_ENV=development
DEBUG=true

# SQLite by default for zero-setup local dev.
# For MySQL 8 use (database is auto-created at startup if missing):
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/Unnati?charset=utf8mb4
# For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/Unnati
DATABASE_URL=sqlite:///./Unnati.db

LLM_ENABLED=true
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/auto
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

WEATHER_ENABLED=false
WEATHER_API_KEY=

CORS_ORIGINS=http://localhost:5173

DEMO_MODE=true

MAX_POOL_RADIUS_KM=40
MAX_HARVEST_TIME_DIFF_HOURS=24
MIN_LISTING_QUANTITY_KG=50
